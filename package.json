{
  "name": "@kasanie_laski/omni-notifier",
  "version": "0.1.0",
  "description": "Unified notification lib, worked with Pachca, Telegram and Discord. No deps, only native fetch",
  "keywords": [
    "notifier",
    "notifications",
    "telegram",
    "discord",
    "pachca",
    "пачка",
    "bot",
    "webhook"
  ],
  "license": "ISC",
  "author": "kasanielaski",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kasanielaski/omni-notifier.git"
  },
  "bugs": {
    "url": "https://github.com/kasanielaski/omni-notifier/issues"
  },
  "homepage": "https://github.com/kasanielaski/omni-notifier#readme",
  "type": "commonjs",
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./telegram": {
      "types": "./build/src/telegram/index.d.ts",
      "default": "./build/src/telegram/index.js"
    },
    "./discord": {
      "types": "./build/src/discord/index.d.ts",
      "default": "./build/src/discord/index.js"
    },
    "./pachca": {
      "types": "./build/src/pachca/index.d.ts",
      "default": "./build/src/pachca/index.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "telegram": ["./build/src/telegram/index.d.ts"],
      "discord": ["./build/src/discord/index.d.ts"],
      "pachca": ["./build/src/pachca/index.d.ts"]
    }
  },
  "files": [
    "build",
    "src",
    "index.ts",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rimraf build",
    "prebuild": "npm run clean"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  }
}
